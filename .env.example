# Copia in .env.local e metti i tuoi valori. Non committare mai .env o .env.local.
# I valori qui sotto sono finti.

# Chiave dell'API di Claude, solo lato server
ANTHROPIC_API_KEY=chiave-finta-da-sostituire

# Facoltativa: modello da usare (se vuota, claude-sonnet-5-5)
SMISTA_MODELLO=claude-sonnet-5-5

# Postgres (region UE), solo per i contatori dei limiti giornalieri. In locale lasciala commentata: i contatori stanno in memoria.
# DATABASE_URL=postgresql://utente:password-finta@host-finto.example:5432/smista?sslmode=require

# Sale segreto per l'hash degli IP (generalo con: openssl rand -hex 32)
SMISTA_SALE_IP=sale-finto-da-sostituire
